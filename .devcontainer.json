{
    "name": "Hugo Codespace setup script",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/go:1": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/hugo:1": {
            "version": "latest",
            "extended": false
        }
    },
    "postCreateCommand": "hugo mod get -u && chmod +x env.sh && ./env.sh"
}
