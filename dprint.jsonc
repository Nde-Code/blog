// dprint configuration: https://dprint.dev/
// Install the configured plugins with `dprint install` before running `dprint fmt`.
{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 100,
    "useTabs": false,
    "newLineKind": "lf",
    "includes": [
        "**/*.md",
        "**/*.json",
        "**/*.css",
        "**/*.yaml",
        "**/*.yml",
        "**/*.toml"
    ],
    "excludes": [
        "archetypes/default.md"
    ],
    "markdown": {
        "lineWidth": 100
    },
    "json": {
        "indentWidth": 4,
        "useTabs": false,
        "lineWidth": 100
    },
    "malva": {
        "indentWidth": 4
    },
    "yaml": {
        "indentWidth": 2
    },
    "toml": {
        "indentWidth": 2,
        "lineWidth": 100
    },
    "plugins": [
        "npm:@dprint/markdown@0.28.0",
        "npm:@dprint/json@0.25.2",
        "npm:dprint-plugin-malva@0.16.0",
        "npm:dprint-plugin-yaml@0.6.0",
        "npm:@dprint/toml@0.9.0"
    ]
}
